<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Текст - занимает все пространство слева до redact_t -->
    <TextView
        android:id="@+id/tema_t"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_toStartOf="@+id/redact_t"
        android:layout_alignParentStart="true"
        android:fontFamily="sans-serif-medium"
        android:text="Hello"
        android:textColor="@color/white"
        android:textSize="25sp"
        android:paddingEnd="8dp"/>

    <!-- Кнопка редактирования - 20dp от delete_t -->
    <ImageButton
        android:id="@+id/redact_t"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_toStartOf="@+id/delete_t"
        android:layout_marginEnd="50dp"
        android:src="@drawable/ic_redact"
        android:background="@android:color/transparent"/>

    <!-- Кнопка удаления - 5dp от правого края -->
    <ImageButton
        android:id="@+id/delete_t"
        android:layout_width="35dp"
        android:layout_height="35dp"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="10dp"
        android:src="@drawable/ic_close_white"
        android:background="@android:color/transparent"/>

</RelativeLayout>